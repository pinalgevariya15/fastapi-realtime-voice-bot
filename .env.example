# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# AI Provider API Keys (Fill in at least one: GROQ_API_KEY or OPENAI_API_KEY)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Pipeline Provider Selections
# STT Provider: "groq", "openai", or "mock"
STT_PROVIDER=groq
# STT Model (e.g., "whisper-large-v3" for Groq, "whisper-1" for OpenAI)
STT_MODEL=whisper-large-v3

# LLM Provider: "groq", "openai", or "mock"
LLM_PROVIDER=groq
# LLM Model (e.g., "llama-3.3-70b-versatile" for Groq, "gpt-4o-mini" for OpenAI)
LLM_MODEL=llama-3.3-70b-versatile

# TTS Provider: "edge-tts" (recommended, zero-key free neural voice) or "openai"
TTS_PROVIDER=edge-tts
# TTS Voice (e.g., "en-US-JennyNeural", "en-US-GuyNeural", "en-US-AriaNeural")
TTS_VOICE=en-US-JennyNeural
